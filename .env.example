# SignBridge — M5 backend secrets. Copy to `.env.local` and fill in.
# NEVER commit real values. `.env.local` is gitignored.

# --- Clerk (auth) — https://dashboard.clerk.com → API Keys ---
# Public key is exposed to the browser (VITE_ prefix = bundled). Safe by design.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Secret key is server-only (Vercel Functions). NEVER prefix with VITE_.
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY_HERE

# --- Neon Postgres (DB) — https://console.neon.tech → Connection string ---
# Pooled connection string for serverless (Vercel Functions).
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/signbridge?sslmode=require

# --- Sentry (telemetry, optional; disabled unless set) ---
# Frame/landmark/text data is NEVER sent. Consent + localOnly gated (OPS-5).
VITE_SENTRY_DSN=
